# Copy to .env — every value is optional until you make live LLM calls.
# Tests and classroom demos run on the deterministic FakeLLM and need NO key.

# fake | ollama | anthropic | openai   (openai also covers OpenRouter via OPENAI_BASE_URL)
#   fake    = offline, deterministic (the CI lane)
#   ollama  = a real model on YOUR machine, no key: install Ollama, then
#             `ollama pull qwen2.5:7b-instruct` (about 4.7 GB, needs 8 GB RAM)
BOOTCAMP_PROVIDER=fake

# Model name for your chosen provider
# (ollama default: qwen2.5:7b-instruct; anthropic: claude-sonnet-5; openai: gpt-4o-mini)
BOOTCAMP_MODEL=

# Only for ollama, and only if the server is not on this machine
# OLLAMA_BASE_URL=http://localhost:11434/v1

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For OpenRouter set: OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=
