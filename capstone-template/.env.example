# Copy to .env and fill in only what you use. .env is gitignored; this file is
# committed, so it never holds a value.
#
# Empty BOOTCAMP_PROVIDER means the offline FakeLLM: the tests and CI lane.
# fake | ollama | anthropic | openai   (openai also covers OpenRouter)
BOOTCAMP_PROVIDER=
BOOTCAMP_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
